// Saldo data model (see docs/PROJECT_PLAN.md section 7)
// CategorizationRule, Budget and RecurringPayment are added in later phases.
// Category is included early (ahead of Phase 3) to power the Overview dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  /// Supabase Auth user id (auth.users.id). Null only for a legacy,
  /// pre-auth row that hasn't been claimed by a signed-in user yet.
  authUserId   String?       @unique @map("auth_user_id")
  email        String?       @unique
  currency     String        @default("EUR")
  createdAt    DateTime      @default(now()) @map("created_at")
  accounts     Account[]
  transactions Transaction[]
  imports      Import[]

  @@map("users")
}

model Account {
  id                    String        @id @default(cuid())
  userId                String        @map("user_id")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  ibanEncrypted         String        @unique @map("iban_encrypted")
  ibanLastFour          String        @map("iban_last_four")
  bankName              String        @default("ING") @map("bank_name")
  accountType           String?       @map("account_type")
  latestBalance         Decimal?      @map("latest_balance") @db.Decimal(12, 2)
  latestTransactionDate DateTime?     @map("latest_transaction_date")
  createdAt             DateTime      @default(now()) @map("created_at")
  transactions          Transaction[]
  imports               Import[]

  @@map("accounts")
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id               String        @id @default(cuid())
  name             String        @unique
  type             CategoryType
  color            String
  isSystemCategory Boolean       @default(true) @map("is_system_category")
  transactions     Transaction[]

  @@map("categories")
}

model Transaction {
  id                        String               @id @default(cuid())
  /// Denormalized from account.userId so RLS policies on this table don't
  /// need a subquery join through accounts.
  userId                    String               @map("user_id")
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId                 String               @map("account_id")
  account                   Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionDate           DateTime             @map("transaction_date")
  description               String
  merchant                  String?
  counterpartyIbanEncrypted String?              @map("counterparty_iban_encrypted")
  counterpartyIbanLastFour  String?              @map("counterparty_iban_last_four")
  amount                    Decimal              @db.Decimal(12, 2)
  direction                 TransactionDirection
  categoryId                String?              @map("category_id")
  category                  Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mutationCode              String?              @map("mutation_code")
  mutationType              String?              @map("mutation_type")
  balanceAfterTransaction   Decimal?             @map("balance_after_transaction") @db.Decimal(12, 2)
  tag                       String?
  isTransfer                Boolean              @default(false) @map("is_transfer")
  isRecurring               Boolean              @default(false) @map("is_recurring")
  notes                     String?
  sourceImportId            String               @map("source_import_id")
  sourceImport              Import               @relation(fields: [sourceImportId], references: [id], onDelete: Cascade)
  duplicateFingerprint      String               @unique @map("duplicate_fingerprint")
  createdAt                 DateTime             @default(now()) @map("created_at")

  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([userId])
  @@map("transactions")
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Import {
  id                String        @id @default(cuid())
  /// Set directly (not derived from accountId, which can be null while an
  /// import is still being processed) so RLS can scope imports by owner
  /// without depending on account resolution.
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String        @map("file_name")
  accountId         String?       @map("account_id")
  account           Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fileHash          String        @map("file_hash")
  status            ImportStatus  @default(PROCESSING)
  importedAt        DateTime      @default(now()) @map("imported_at")
  dateFrom          DateTime?     @map("date_from")
  dateTo            DateTime?     @map("date_to")
  rowsSeen          Int           @default(0) @map("rows_seen")
  rowsImported      Int           @default(0) @map("rows_imported")
  duplicatesSkipped Int           @default(0) @map("duplicates_skipped")
  errors            Json?
  transactions      Transaction[]

  @@unique([userId, fileHash])
  @@index([userId])
  @@map("imports")
}
