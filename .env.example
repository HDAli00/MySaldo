# Supabase Postgres connection (project: mysaldo, ref: hoieomdnstqlfjpsikfc, eu-west-1)
# Get the [YOUR-PASSWORD] value from Supabase Dashboard > Project Settings > Database
# (or reset it there if you don't have it).

# Pooled connection (Supavisor, transaction mode) — used by the app at runtime.
# IMPORTANT: after running `prisma migrate deploy` once, this must use the
# restricted `saldo_app` role created by the add_auth_and_rls migration, NOT
# the `postgres` superuser — the superuser bypasses Row Level Security, which
# would make the RLS policies decorative. Set its password once via the
# Supabase SQL editor:
#   ALTER ROLE saldo_app WITH PASSWORD '<a strong random password>';
# then point DATABASE_URL at it, e.g.:
#   postgresql://saldo_app.hoieomdnstqlfjpsikfc:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.hoieomdnstqlfjpsikfc:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode) — used by Prisma Migrate. Keep this on the
# privileged `postgres` role: migrations need to create roles/policies, which
# the restricted saldo_app role cannot do.
DIRECT_URL="postgresql://postgres.hoieomdnstqlfjpsikfc:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# 32-byte hex key used to encrypt IBANs at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IBAN_ENCRYPTION_KEY=

# Supabase Auth (magic-link sign-in). From Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://hoieomdnstqlfjpsikfc.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
