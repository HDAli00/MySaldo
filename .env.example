# Supabase project (project: mysaldo, ref: hoieomdnstqlfjpsikfc, eu-west-1)
# Project Settings > API for these values.

# Public project URL and anon (public) key. The app talks to Postgres
# directly through Supabase's REST API (PostgREST) via @supabase/supabase-js
# — no ORM, no DATABASE_URL/DIRECT_URL connection string. See
# src/lib/db.ts and supabase/migrations/ for the RLS policies this relies on.
NEXT_PUBLIC_SUPABASE_URL="https://hoieomdnstqlfjpsikfc.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32-byte hex key used to encrypt IBANs at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IBAN_ENCRYPTION_KEY=
